{"nodes": [{"id": "skills_abap_skills_basis_skill", "label": "Basis Skill (Running System Inspection)", "file_type": "document", "source_file": "skills/ABAP/skills/basis/SKILL.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Answers operational questions about what a running system is doing from an ADT session rather than SAP GUI; repository questions belong to the abap / clean-abap skills."}, {"id": "skills_abap_skills_basis_skill_per_instance_session_scope", "label": "Logged-on Users Are Per Application Server (TH_USER_LIST / SM04)", "file_type": "rationale", "source_file": "skills/ABAP/skills/basis/SKILL.md", "source_location": "L39", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "TH_USER_LIST reports only the instance the session is connected to (SM04, not AL08); on a multi-instance system 'nobody logged on' means nobody on this instance, so answers must say so."}, {"id": "skills_abap_skills_basis_skill_service_users_vs_named_users", "label": "Separate Service Users from Named Users", "file_type": "rationale", "source_file": "skills/ABAP/skills/basis/SKILL.md", "source_location": "L46", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Most sessions belong to technical users (SAPJSF_*, BGRFCSUPER, SAPSYS, RFC*) and the MCP server's own HTTP/ICF session appears too, so raw counts overstate human usage; a filtered zero must quote filter.totalBeforeFilter."}, {"id": "skills_abap_skills_basis_skill_raw_logon_type_integers", "label": "logonType / logonState / logonProtocol Kept as Raw Integers", "file_type": "rationale", "source_file": "skills/ABAP/skills/basis/SKILL.md", "source_location": "L42", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Data elements UEXT_TYPE, USTATE and UPROTOCOL have no domain, so any label would be invented; observable fields (transaction, guiVersion, rfcType) are used instead."}, {"id": "skills_abap_skills_basis_skill_profile_parameter_flags", "label": "Profile Parameter exists vs isSet Flags (rc 4 = No Such Parameter)", "file_type": "rationale", "source_file": "skills/ABAP/skills/basis/SKILL.md", "source_location": "L67", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "exists:false answers 'did I spell it right' while an empty value with exists:true means genuinely empty; all parameters failing at once means missing S_ADMI_FCD authorisation, not configuration."}, {"id": "skills_abap_skills_basis_skill_th_get_parameter", "label": "TH_GET_PARAMETER (Function Group THFB2)", "file_type": "concept", "source_file": "skills/ABAP/skills/basis/SKILL.md", "source_location": "L201", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_abap_skills_basis_skill_vclient_overrides_verify_client", "label": "Per-port VCLIENT Overrides icm/HTTPS/verify_client", "file_type": "rationale", "source_file": "skills/ABAP/skills/basis/SKILL.md", "source_location": "L99", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Client certificates are requested per ICM port (VCLIENT=1/2 inside icm/server_port_<n>), overriding the global parameter, so reading the global value alone is wrong in both directions; the tool reports decidedBy. SNC0 governs RFC/SAP GUI, not ADT over HTTPS."}, {"id": "skills_abap_skills_basis_skill_logon_check_limits", "label": "Not Determinable from Parameters: STRUST, CERTRULE, SPNEGO", "file_type": "concept", "source_file": "skills/ABAP/skills/basis/SKILL.md", "source_location": "L112", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reported as not determinable / stillToVerifyManually rather than unsupported, because silence would read as 'no'."}, {"id": "skills_abap_skills_basis_skill_rfc_system_info", "label": "RFC_SYSTEM_INFO (System Identity)", "file_type": "concept", "source_file": "skills/ABAP/skills/basis/SKILL.md", "source_location": "L136", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Establish which system you are on before reporting anything about it."}, {"id": "skills_abap_skills_basis_skill_s_rfc_function_group_semantics", "label": "S_RFC Checked per Function Group (-32601 Interpretation)", "file_type": "rationale", "source_file": "skills/ABAP/skills/basis/SKILL.md", "source_location": "L188", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A readable signature does not mean a callable module; since S_RFC is checked on the function group, -32601 while a sibling module answers means 'not RFC-enabled' rather than 'not authorised'."}, {"id": "skills_abap_skills_basis_skill_jsonrpc_batch_single_luw", "label": "JSON-RPC Batch Shares One LUW (Rollback Probe)", "file_type": "rationale", "source_file": "skills/ABAP/skills/basis/SKILL.md", "source_location": "L196", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "State-changing calls are operational actions needing user confirmation; ending a batch with BAPI_TRANSACTION_ROLLBACK is the safe way to probe a write."}, {"id": "skills_abap_skills_basis_skill_stateful_session_locks", "label": "Locks Held in Stateful Session (dropSession Escape Hatch)", "file_type": "concept", "source_file": "skills/ABAP/skills/basis/SKILL.md", "source_location": "L169", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "skills_abap_skills_basis_skill", "target": "skills_abap_skills_clean_abap_skill", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/ABAP/skills/basis/SKILL.md", "source_location": "L3", "weight": 1.0}, {"source": "skills_abap_skills_basis_skill", "target": "src_handlers_basishandlers_basishandlers_listloggedonusers",