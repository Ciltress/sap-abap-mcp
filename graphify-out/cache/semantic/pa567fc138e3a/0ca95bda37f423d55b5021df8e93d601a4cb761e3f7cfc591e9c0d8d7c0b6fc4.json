{"nodes": [{"id": "skills_abap_skills_btp_diagram_generator_skill", "label": "BTP Solution Diagram Generator Skill", "file_type": "document", "source_file": "skills/ABAP/skills/btp-diagram-generator/SKILL.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_abap_skills_btp_diagram_generator_skill_quick_path", "label": "Quick Path (btp_builder DSL)", "file_type": "rationale", "source_file": "skills/ABAP/skills/btp-diagram-generator/SKILL.md", "source_location": "L10", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Do not hand-write XML: the builder owns icon lookup, SAP palette, port pinning, label HTML, A4 sizing, SVG upscaling and validation, so a typical L1 diagram is ~20 lines."}, {"id": "skills_abap_skills_btp_diagram_generator_skill_manual_xml_path", "label": "Manual XML Path (Advanced / Niche Cases)", "file_type": "concept", "source_file": "skills/ABAP/skills/btp-diagram-generator/SKILL.md", "source_location": "L94", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_abap_skills_btp_diagram_generator_skill_component_allowlist", "label": "Component Allowlist Discipline", "file_type": "rationale", "source_file": "skills/ABAP/skills/btp-diagram-generator/SKILL.md", "source_location": "L126", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Do not add familiar products as decoration; preserve the requested sequence as an ordered edge list without inserting intermediaries."}, {"id": "skills_abap_skills_btp_diagram_generator_skill_no_mxgraph_sap_stencil", "label": "No mxgraph.sap.* Stencil Family", "file_type": "rationale", "source_file": "skills/ABAP/skills/btp-diagram-generator/SKILL.md", "source_location": "L138", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SAP BTP icons are base64 SVGs embedded in shape=image style strings from the SAP shape libraries; invented mxgraph.sap.* shapes render as empty squares."}, {"id": "skills_abap_skills_btp_diagram_generator_skill_fiori_horizon_palette", "label": "SAP Fiori Horizon Palette", "file_type": "concept", "source_file": "skills/ABAP/skills/btp-diagram-generator/SKILL.md", "source_location": "L159", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_abap_skills_btp_diagram_generator_skill_audience_levels", "label": "Audience Levels L0 / L1 / L2", "file_type": "concept", "source_file": "skills/ABAP/skills/btp-diagram-generator/SKILL.md", "source_location": "L115", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_abap_skills_btp_diagram_generator_skill_connector_semantics", "label": "Connector Line Style and Semantic Color", "file_type": "concept", "source_file": "skills/ABAP/skills/btp-diagram-generator/SKILL.md", "source_location": "L190", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Line style encodes flow nature (solid sync, dashed async, dotted optional, thick only for firewalls) and color encodes semantic (green auth, indigo SCIM, pink trust, slate data)."}, {"id": "skills_abap_skills_btp_diagram_generator_skill_svg_intrinsic_size_blur", "label": "SVG Intrinsic Size Blur", "file_type": "rationale", "source_file": "skills/ABAP/skills/btp-diagram-generator/SKILL.md", "source_location": "L149", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every library SVG declares 16x16 intrinsic size; draw.io rasterizes at that size and upscales, so the root svg width/height must be patched to the cell size while keeping viewBox."}, {"id": "skills_abap_skills_btp_diagram_generator_skill_a4_landscape_page", "label": "A4 Landscape Page Size", "file_type": "concept", "source_file": "skills/ABAP/skills/btp-diagram-generator/SKILL.md", "source_location": "L224", "source_url": 