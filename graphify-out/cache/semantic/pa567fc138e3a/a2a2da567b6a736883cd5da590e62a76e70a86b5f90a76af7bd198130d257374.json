{"nodes": [{"id": "skills_readme", "label": "Skills README", "file_type": "document", "source_file": "skills/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Explains how this MCP server serves agent skills, the provenance of its two collections, local changes, and how to add a skill."}, {"id": "skills_readme_abap_collection", "label": "ABAP Skills Collection", "file_type": "concept", "source_file": "skills/README.md", "source_location": null, "source_url": "https://github.com/likweitan/abap-skills", "captured_at": null, "author": null, "contributor": null, "rationale": "Vendored from likweitan/abap-skills at eccc4d0 and maintained here: 20 skills (18 upstream plus basis and abap-analyze-modification)."}, {"id": "skills_readme_development_collection", "label": "Development Skills Collection", "file_type": "concept", "source_file": "skills/README.md", "source_location": null, "source_url": "https://github.com/mattpocock/skills", "captured_at": null, "author": null, "contributor": null, "rationale": "Git submodule of mattpocock/skills pinned at 068b6e0, 35 skills, unmodified; only skills/Development/skills/ is read by the server. A plain clone leaves it empty, so clone with --recurse-submodules."}, {"id": "skills_readme_vendor_vs_submodule", "label": "Vendor vs Submodule Provenance", "file_type": "rationale", "source_file": "skills/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ABAP is vendored because ten of its skills are modified to use this server's tools, making it ours (upstream commit recorded for attribution and future diffs). Development is a submodule because it is unmodified, so upstream stays the source of truth and updates arrive with one command."}, {"id": "skills_readme_skill_discovery_cache", "label": "Per-Process Skill Discovery Cache", "file_type": "rationale", "source_file": "skills/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Discovery walks each collection's skills/ directory for SKILL.md files, so changes need no rebuild, but discoverSkills() caches per process so a running server serves the old set until restarted."}, {"id": "skills_readme_skill_resource_uri", "label": "abap-adt://skills Resource URI", "file_type": "concept", "source_file": "skills/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Skills are exposed as MCP resources under abap-adt://skills/<collection>/<name>."}, {"id": "skills_readme_readskill_tool", "label": "readSkill Tool", "file_type": "concept", "source_file": "skills/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "MCP tool serving skills; its file argument reaches supporting files beside a SKILL.md."}, {"id": "skills_readme_mcp_adaptation", "label": "ABAP Skills MCP Adaptation", "file_type": "rationale", "source_file": "skills/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ten ABAP skills use this server's tools rather than assuming no live system: abap and clean-abap are restructured with a 'Step 0 - is there a system?' branch and new references/mcp-adt-tools.md; eight more (abap-sql-amdp, abap-unit-testing, abapgit, atc-cloudification, cds-view-entities, odata, rap, released-abap-classes) gain an appended 'Using the ABAP ADT MCP server' section."}, {"id": "skills_readme_basis_skill", "label": "basis Skill", "file_type": "concept", "source_file": "skills/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Written locally rather than taken from upstream: operational questions about a running system, paired with the listLoggedOnUsers tool."}, {"id": "skills_readme_listloggedonusers_tool", "label": "listLoggedOnUsers Tool", "file_type": "concept", "source_file": "skills/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_readme_removed_scaffolding", "label": "Removed Upstream Scaffolding", "file_type": "rationale", "source_file": "skills/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only skills/ and LICENSE were kept when vendoring ABAP; .github/ (skills-validation workflow, FUNDING.yml) and other project scaffolding were dropped because vendored they would have run and solicited sponsorship on this repository. No skill referenced anything outside its own directory, so nothing broke."}, {"id": "skills_readme_adding_a_skill", "label": "Adding a Skill", "file_type": "rationale", "source_file": "skills/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Add to ABAP or a new collection, never to Development, whose changes belong upstream and would be lost on update. Create <collection>/skills/<name>/SKILL.md with name and description front matter, writing the description as trigger phrases because that is what an agent matches on."}, {"id": "skills_readme_mit_license", "label": "MIT License Retention", "file_type": "concept", "source_file": "skills/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each collection keeps its upstream MIT LICENSE; the licence text and copyright notice must stay with the files."}], "edges": [{"source": "skills_readme", "target": "skills_readme_abap_collection", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/README.md", "source_location": null, "weight": 1.0}, {"source": "skills_readme", "target": "ski