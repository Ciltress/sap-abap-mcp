{"nodes": [{"id": "docs_adr_0002_composite_tools_for_multi_step_protocols", "label": "ADR-0002: Composite tools where the protocol is the hard part", "file_type": "document", "source_file": "docs/adr/0002-composite-tools-for-multi-step-protocols.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The four-step edit cycle's ordering, the lifetime of the lock handle and the obligation to unlock after a failure were all outside the schemas, written as prose. A rule a model has to remember across four calls is one it will sometimes forget, and an orphaned lock on a shared system blocks other developers. The demand for the composite was explicit, which meets ADR-0001's evidence bar."}, {"id": "docs_adr_0002_composite_tools_for_multi_step_protocols_shallow_interface", "label": "Four-step edit cycle as a shallow interface", "file_type": "rationale", "source_file": "docs/adr/0002-composite-tools-for-multi-step-protocols.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_0002_composite_tools_for_multi_step_protocols_ordering_and_obligations_test", "label": "Ordering-and-obligations test for composite tools", "file_type": "rationale", "source_file": "docs/adr/0002-composite-tools-for-multi-step-protocols.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Wrap a sequence only when its ordering and obligations are the hard part, not merely because several calls happen to be adjacent. A composite must leave the system no worse than it found it: unlock in finally, and report an unlock it could not perform without masking the original failure."}, {"id": "docs_adr_0002_composite_tools_for_multi_step_protocols_first_try_success", "label": "First-try success from a cold session", "file_type": "rationale", "source_file": "docs/adr/0002-composite-tools-for-multi-step-protocols.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_adr_0002_composite_tools_for_multi_step_protocols", "target": "docs_adr_0001_presentation_over_coverage", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0002-composite-tools-for-multi-step-protocols.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0002_composite_tools_for_multi_step_protocols", "target": "docs_adr_0001_presentation_over_coverage_demand_is_the_evidence", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0002-composite-tools-for-multi-step-protocols.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0002_composite_tools_for_multi_step_protocols", "target": "docs_adr_0002_composite_tools_for_multi_step_protocols_shallow_interface", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0002-composite-tools-for-multi-step-protocols.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0002_composite_tools_for_multi_step_protocols", "target": "docs_adr_0002_composite_tools_for_multi_step_protocols_ordering_and_obligations_test", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0002-composite-tools-for-multi-step-protocols.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0002_composite_tools_for_multi_step_protocols", "target": "docs_adr_0002_composite_tools_for_multi_step_protocols_first_try_success", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0002-composite-tools-for-multi-step-protocols.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0002_composite_tools_for_multi_step_protocols", "target": "docs_tool_reference_editabapsource", "relation": "rationale_for", "confidence": 