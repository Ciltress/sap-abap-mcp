{"nodes": [{"id": "docs_authentication", "label": "Authentication.md", "file_type": "document", "source_file": "docs/Authentication.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_authentication_session_injection", "label": "Session cookies + CSRF token injection (shared endpoint of all logon modes)", "file_type": "concept", "source_file": "docs/Authentication.md", "source_location": "L3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_authentication_kerberos_mode", "label": "Kerberos / SPNEGO SSO mode", "file_type": "concept", "source_file": "docs/Authentication.md", "source_location": "L8", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Node cannot do SPNEGO, so the server shells out to curl --negotiate."}, {"id": "docs_authentication_certificate_mode", "label": "X.509 client certificate mode", "file_type": "concept", "source_file": "docs/Authentication.md", "source_location": "L9", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A technical user has no Windows logon to borrow a ticket from; the mode for anything unattended on-premise."}, {"id": "docs_authentication_oauth_mode", "label": "OAuth 2.0 bearer token mode", "file_type": "concept", "source_file": "docs/Authentication.md", "source_location": "L635", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "BTP ABAP has no Kerberos realm and no ICM to configure, so the two unattended modes do not exist there."}, {"id": "docs_authentication_password_mode", "label": "Password (HTTP Basic) mode", "file_type": "concept", "source_file": "docs/Authentication.md", "source_location": "L566", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The last resort: a wrong password counts against login/fails_to_user_lock and locks the user for every consumer."}, {"id": "docs_authentication_mutual_tls_not_snc", "label": "Certificate mode is mutual TLS, not SNC", "file_type": "rationale", "source_file": "docs/Authentication.md", "source_location": "L30", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ADT and the JSON-RPC tunnel are HTTPS, so SNC (an RFC concept) does not apply; the CERTRULE mapping carries over, SNC0/snc_* settings do not."}, {"id": "docs_authentication_certrule_mapping", "label": "CERTRULE certificate-to-user mapping", "file_type": "concept", "source_file": "docs/Authentication.md", "source_location": "L63", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_authentication_vclient_port_trap", "label": "Per-port VCLIENT overrides icm/HTTPS/verify_client", "file_type": "rationale", "source_file": "docs/Authentication.md", "source_location": "L66", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_authentication_strust_ca_trust", "label": "Issuing CA trusted in STRUST", "file_type": "concept", "source_file": "docs/Authentication.md", "source_location": "L71", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_authentication_legacy_pkcs12_trap", "label": "sapgenpse legacy PKCS#12 refused by OpenSSL 3", "file_type": "rationale", "source_file": "docs/Authentication.md", "source_location": "L126", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_authentication_reachability_probe", "label": "Two-layer reachability probe (/sap/public/ping + /sap/bc/ping)", "file_type": "concept", "source_file": "docs/Authentication.md", "source_location": "L236", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SAP answers 403 before offering a logon, so an 'icf' layer failure must not be read as an authentication failure."}, {"id": "docs_authentication_missing_s_develop", "label": "403 with session cookie means missing S_DEVELOP", "file_type": "concept", "source_file": "docs/Authentication.md", "source_location": "L313", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_authentication_rfc_fallback", "label": "ABAP_MCP_RFC_FALLBACK session fallback", "file_type": "concept", "source_file": "docs/Authentication.md", "source_location": "L335", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Off by default because a logon failure is a diagnosis and quietly downgrading hides the real problem; when the fallback also fails the original ADT error is thrown."}, {"id": "docs_authentication_container_credentials", "label": "Container credential setup (section 7)", "file_type": "concept", "source_file": "docs/Authentication.md", "source_location": "L388", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_authentication_debian_not_alpine", "label": "Debian base image, not Alpine", "file_type": "rationale", "source_file": "docs/Authentication.md", "source_location": "L400", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Alpine's curl is built without GSS-API and silently never sends a token, producing the same 401 as an expired ticket."}, {"id": "docs_authentication_windows_ticket_limitation", "label": "Windows host cannot pass its TGT into a container", "file_type": "rationale", "source_file": "docs/Authentication.md", "source_location": "L466", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_authentication_keytab_credential", "label": "Kerberos keytab credential (SAP_KRB_KEYTAB)", "file_type": "concept", "source_file": "docs/Authentication.md", "source_location": "L454", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_authentication_placeholder_password", "label": "unused-sso-placeholder password", "file_type": "rationale", "source_file": "docs/Authentication.md", "source_location": "L524", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ADTClient rejects an empty password; the placeholder is never sent because session injection stops AdtHTTP's Basic logon, which would otherwise lock the account."}, {"id": "docs_authentication_logon_failure_latch", "label": "Latched logon failures (no retry)", "file_type": "rationale", "source_file": "docs/Authentication.md", "source_location": "L595", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A rejected password or refused token request is marked permanent and re-thrown without contacting SAP, so five tool calls cost one failed logon, not five."}, {"id": "docs_authentication_fails_to_user_lock", "label": "login/fails_to_user_lock policy", "file_type": "concept", "source_file": "docs/Authentication.md", "source_location": "L20", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_authentication_oauth_grants", "label": "OAuth grants (client_credentials, refresh_token, password, static)", "file_type": "concept", "source_file": "docs/Authentication.md", "source_location": "L690", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_authentication_no_authorization_code_flow", "label": "Authorization-code flow deliberately not implemented", "file_type": "rationale", "source_file": "docs/Authentication.md", "source_location": "L699", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "It needs a browser and a redirect listener; a server started over stdio has neither."}, {"id": "docs_authentication_per_connection_sessions", "label": "Per-connection SAP sessions over Streamable HTTP (section 12)", "file_type": "concept", "source_file": "docs/Authentication.md", "source_location": "L784", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A team-shared container must not collapse everyone into one SAP user and one set of locks, so every MCP session logs on with its own OAuth token."}, {"id": "docs_authentication_origin_allowlist", "label": "Origin allow-list (DNS rebinding guard)", "file_type": "rationale", "source_file": "docs/Authentication.md", "source_location": "L861", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A rebinding request never passes through the reverse proxy, so the server checks the unforgeable Origin header itself, as the MCP spec asks."}, {"id": "docs_authentication_allowed_hosts", "label": "Host header allow-list", "file_type": "concept", "source_file": "docs/Authentication.md", "source_location": "L886", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_authentication_refresh_token_sessions", "label": "Self-renewing sessions via X-SAP-Refresh-Token", "file_type": "concept", "source_file": "docs/Authentication.md", "source_location": "L892", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_authentication_session_rate_limit", "label": "Per-session token-bucket rate limit", "file_type": "concept", "source_file": "docs/Authentication.md", "source_location": "L932", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A proxy sees addresses; what is worth limiting is one looping agent session spending SAP work processes. A token bucket does not punish a legitimate burst."}, {"id": "docs_authentication_no_tls_termination", "label": "TLS termination left to a reverse proxy", "file_type": "rationale", "source_file": "docs/Authentication.md", "source_location": "L950", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_authentication_auth_mode_selection", "label": "Auth mode selection (resolveAuthMode, SAP_AUTH_MODE)", "file_type": "concept", "source_file": "docs/Authentication.md", "source_location": "L156", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "When both a certificate and a password are configured the certificate wins, preferring the mode that cannot lock the account."}], "edges": [{"source": "docs_authentication_kerberos_mode", "target": "docs_authentication_session_injection", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/Authentication.md", "source_location": "L3", "weight": 1.0}, {"source": "docs_authentication_certificate_mode", "target": "docs_authentication_session_injection", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/Authentication.md", "source_location": "L3", "weight": 1.0}, {"source": "docs_authentication_oauth_mode", "target": "docs_authentication_session_injection", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/Authentication.md", "source_location": "L3", "weight": 1.0}, {"source": "docs_authentication_password_mode", "target": "docs_authentication_session_injection", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/Authentication.md", "source_location": "L3", "weight": 1.0}, {"source": "docs_authentication_certificate_mode", "target": "src_certauth", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/Authentication.md", "source_location": "L559", "weight": 1.0}, {"source": "docs_authentication_certificate_mode", "target": "src_certauth_createcertificateagent", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/Authentication.md", "source_location": "L547", "weight": 1.0}, {"source": "docs_authentication_certificate_mode", "target": "src_certauth_bootstrapcertificatesession", "relation": "referen