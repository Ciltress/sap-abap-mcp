{"nodes": [{"id": "agents", "label": "AGENTS.md", "file_type": "document", "source_file": "AGENTS.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_never_write_to_stdout", "label": "Never write to stdout convention", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": "L80", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The server speaks MCP over stdio; anything on stdout that is not a protocol frame corrupts the stream. This has broken every tool at once before."}, {"id": "agents_basehandler_toolspec_contract", "label": "ToolSpec / BaseHandler contract", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": "L83", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A tool returns plain data; BaseHandler.handle() owns dispatch, timing, the MCP envelope and error mapping. Building the envelope in a handler would nest JSON inside JSON because serializeResult() passes it through."}, {"id": "agents_one_file_tool_addition", "label": "Adding a tool is a one-file change", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": "L94", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "getTools(), tool routing and tools/list are all derived from toolSpecs(), so a listed tool is always callable."}, {"id": "agents_tool_annotations_convention", "label": "Tool annotations convention (title + four hints)", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": "L97", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "OpenAI's directory rejects a tool that omits destructiveHint/idempotentHint, and omitted hints make clients fall back to not-read-only, destructive, open-world defaults."}, {"id": "agents_response_budget", "label": "Response budget ceiling", "file_type": "concept", "source_file": "AGENTS.md", "source_location": "L105", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "serializeResult() is the single funnel every answer passes through, so the ceiling covers new tools automatically; over-budget answers become valid JSON stating size and next step rather than a cut-off fragment a model would retry."}, {"id": "agents_capability_gate", "label": "ADT discovery capability gate", "file_type": "concept", "source_file": "AGENTS.md", "source_location": "L112", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every failure path leaves the gate empty and the list complete: hiding a tool that would have worked is worse than offering one that errors, because the first is invisible."}, {"id": "agents_generated_tool_reference", "label": "Generated tool reference convention", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": "L123", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "toolDocs.test.ts re-renders and compares against the committed docs/Tool-Reference.md, so a stale reference fails the build instead of shipping a document that lies about the code."}, {"id": "agents_errors_must_be_mcperror", "label": "Errors must be McpError", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": "L129", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A raw Error reaching the client becomes an opaque 'Internal error'."}, {"id": "agents_status_code_not_diagnosis", "label": "A status code is not a diagnosis", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": "L133", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "401 and 403 mean different layers; conflating them reported an inactive ADT ICF node as a missing Kerberos ticket on two systems for two days."}, {"id": "agents_searchobject_traps", "label": "searchObject wildcard and objType traps", "file_type": "concept", "source_file": "AGENTS.md", "source_location": "L140", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "abap-adt-api truncates objType to its first segment (FUGR/FF asks for function groups), so the type filter is applied in the handler with a x10 over-fetch; the query is upper-cased because repository search is case sensitive on older systems."}, {"id": "agents_live_write_verification", "label": "Live-system verification of write paths", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": "L168", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The fake ADTClient accepts any call order; editAbapSource passed 16 tests yet failed on real objects (activated while holding the lock; resolved by name though search indexes only active objects)."}, {"id": "agents_runtime_served_guides", "label": "Guides served at runtime (abap-adt://guides)", "file_type": "concept", "source_file": "AGENTS.md", "source_location": "L29", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_abap_vendored", "label": "skills/ABAP vendored collection", "file_type": "concept", "source_file": "AGENTS.md", "source_location": "L40", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_development_submodule", "label": "skills/Development git submodule", "file_type": "concept", "source_file": "AGENTS.md", "source_location": "L42", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A submodule of mattpocock/skills that must not be edited: changes belong upstream and are lost on the next update."}, {"id": "agents_offline_vitest_suite", "label": "Offline vitest suite", "file_type": "concept", "source_file": "AGENTS.md", "source_location": "L71", "source_url": null, 