{"nodes": [{"id": "readme", "label": "README.md", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_sap_abap_mcp_server", "label": "SAP ABAP MCP Server (ADT and JSON-RPC)", "file_type": "concept", "source_file": "README.md", "source_location": "L11", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Gives an agent read/write ADT access and adds the one thing ADT cannot do: calling RFC-enabled function modules over the SAP Gateway JSON-RPC 2.0 service. 128 tools."}, {"id": "readme_abap_adt_api", "label": "abap-adt-api library", "file_type": "concept", "source_file": "README.md", "source_location": "L18", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_upstream_mcp_abap_abap_adt_api", "label": "Upstream mcp-abap-abap-adt-api (mario-andreschak)", "file_type": "concept", "source_file": "README.md", "source_location": "L30", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "This repo is its SSO fork: Kerberos SSO instead of Basic Auth, JSON-RPC/RFC tools, tool routing derived from tool definitions, a documented tool reference. The npx package is upstream and lacks the SSO bootstrap and RFC tools, so build from source."}, {"id": "readme_mcp_abap_adt_separate_project", "label": "mcp-abap-adt (separate project with GetTable/GetStructure/GetTypeInfo)", "file_type": "concept", "source_file": "README.md", "source_location": "L600", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_passwordless_logon", "label": "Password-less logon modes (Kerberos SSO, X.509 certificate, OAuth 2.0)", "file_type": "rationale", "source_file": "README.md", "source_location": "L53", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No SAP password is stored or sent; Kerberos and certificate modes self-heal when the session expires. The OAuth token logs on once and the session cookie carries every request after, so short-lived tokens are fine. Certificate mode is mutual TLS, not SNC."}, {"id": "readme_password_fallback", "label": "Password logon as last resort", "file_type": "rationale", "source_file": "README.md", "source_location": "L253", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A wrong password counts against login/fails_to_user_lock and locks the user for every consumer, so one rejected password is latched and never retried; prefer a certificate for anything unattended."}, {"id": "readme_sso_curl_bootstrap", "label": "SSO bootstrap via curl --negotiate (SSO_CURL_PATH)", "file_type": "concept", "source_file": "README.md", "source_location": "L92", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shells out to the Windows System32 curl.exe because it needs curl's Schannel/SSPI backend; other platforms must point SSO_CURL_PATH at a curl built with GSS-API."}, {"id": "readme_tool_profiles", "label": "ABAP_MCP_PROFILE tool profiles (core/analyst/rfc/dev/all)", "file_type": "concept", "source_file": "README.md", "source_location": "L155", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A client that cannot fetch tool schemas on demand pays for the whole tool list every turn (core ~2,737 tokens vs all ~17,759). A profile is not a convenience filter: out-of-profile tools are neither listed nor routed, so analyst guarantees nothing edits source; an unrecognised profile name stops the server instead of silently serving 129 tools."}, {"id": "readme_response_budget", "label": "ABAP_MCP_MAX_RESPONSE_BYTES response ceiling", "file_type": "concept", "source_file": "README.md", "source_location": "L185", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The tool list is a fixed cost but an answer is unbounded; an over-budget answer is withheld and replaced by valid JSON (status:truncated, bytes, budget, preview, nextStep), never a cut-off fragment that would not parse and would invite the identical retry."}, {"id": "readme_capability_gate", "label": "ABAP_MCP_GATE startup capability check", "file_type": "concept", "source_file": "README.md", "source_location": "L193", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Asks the system what it supports and withholds tools whose ADT collections are absent (10 abapGit and 3 service-binding tools on DEV) that would otherwise answer HTTP 400; one discovery round trip per process, can only shorten the list, any failure leaves every tool listed."}, {"id": "readme_healthcheck", "label": "healthcheck tool", "file_type": "concept", "source_file": "README.md", "source_location": "L172", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sits outside every profile because it is the tool that answers which profile is running; reports profile, responseBudgetBytes, withheld tools and system identity."}, {"id": "readme_editabapsource", "label": "editAbapSource tool", "file_type": "concept", "source_file": "README.md", "source_location": "L182", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "core is small because this one tool is the whole write cycle (lock, write, unlock, activate), releasing the lock even when a step fails."}, {"id": "readme_readabapobject", "label": "readAbapObject tool", "file_type": "concept", "source_file": "README.md", "source_location": "L61", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_describeabaptable", "label": "describeAbapTable tool", "file_type": "concept", "source_file": "README.md", "source_location": "L63", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_searchpackages", "label": "searchPackages tool", "file_type": "concept", "source_file": "README.md", "source_location": "L65", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_callfunctionviajsonrpc", "label": "callFunctionViaJsonRpc tool", "file_type": "concept", "source_file": "README.md", "source_location": "L70", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_callfunctionsviajsonrpc", "label": "callFunctionsViaJsonRpc tool", "file_type": "concept", "source_file": "README.md", "source_location": "L72", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An update BAPI and BAPI_TRANSACTION_COMMIT must travel in one batch, or the commit lands in its own LUW and the BAPI's changes are lost."}, {"id": "readme_checkjsonrpcendpoint", "label": "checkJsonRpcEndpoint tool", "file_type": "concept", "source_file": "README.md", "source_location": "L636", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_listloggedonusers", "label": "listLoggedOnUsers tool", "file_type": "concept", "source_file": "README.md", "source_location": "L75", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_checklogonconfiguration", "label": "checkLogonConfiguration tool", "file_type": "concept", "source_file": "README.md", "source_location": "L77", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_readskill", "label": "readSkill tool", "file_type": "concept", "source_file": "README.md", "source_location": "L80", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_readserverguide", "label": "readServerGuide tool", "file_type": "concept", "source_file": "README.md", "source_location": "L81", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Self-documenting: guides are served as abap-adt://guides resources and through readServerGuide so an agent can look up a workflow mid-task without leaving the session."}, {"id": "readme_streamable_http_transport", "label": "Streamable HTTP transport mode (ABAP_MCP_TRANSPORT=http)", "file_type": "concept", "source_file": "README.md", "source_location": "L407", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every MCP client authenticates with its own SAP OAuth 2.0 bearer token, so each session gets its own SAP logon, locks and audit trail rather than one shared technical user; the SAP token is the access control, with no separate shared secret."}, {"id": "readme_docker_image", "label": "Docker image deployment", "file_type": "concept", "source_file": "README.md", "source_location": "L300", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Debian rather than Alpine because Alpine's curl lacks GSS-API and silently never sends a token, giving the same 401 as an expired ticket. A keytab is the only credential that runs unattended; a Windows host cannot export its TGT. docs/, skills/ and AGENTS.md are copied in because the server reads them at runtime."}, {"id": "readme_env_file_not_dotenv", "label": "Docker --env-file is not dotenv", "file_type": "rationale", "source_file": "README.md", "source_location": "L329", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Docker strips no quotes, reads no export and drops no trailing comment, so values dotenv would clean arrive verbatim; Windows paths in .env must be replaced by the mounted ones."}, {"id": "readme_multi_system_registration", "label": "One server entry per system/client (SAP_SYSTEM_ID)", "file_type": "concept", "source_file": "README.md", "source_location": "L479", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A server is bound to one system and client for its whole life; announcing SAP_SYSTEM_ID in the MCP instructions lets an agent route a request to the right server without calling anything."}, {"id": "readme_system_identity_check", "label": "Declared vs observed system identity check", "file_type": "concept", "source_file": "README.md", "source_location": "L500", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SAP names system and client in the session cookie (SAP_SESSIONID_DEV_100); a mismatch with SAP_SYSTEM_ID raises a healthcheck WARNING because every tool would otherwise keep working, just on the wrong system."}, {"id": "readme_bundled_agent_skills", "label": "Bundled agent skills (skills/)", "file_type": "concept", "source_file": "README.md", "source_location": "L78", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_recurse_submodules_clone", "label": "Clone with --recurse-submodules", "file_type": "rationale", "source_file": "README.md", "source_location": "L114", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The general engineering skills live in the skills/Development submodule; without it the directory is empty and the server and Docker image offer 38 fewer skills."}, {"id": "readme_client_system_prompt_rules", "label": "Client system-prompt rules (prefer by-name tools, constrain SELECTs)", "file_type": "rationale", "source_file": "README.md", "source_location": "L584", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fall back to searchObject -> objectStructure -> getObjectSource only when intermediate results are needed and never hand-craft /sap/bc/adt paths; SAP tables are large, so always constrain SELECTs with WHERE, SELECT SINGLE or UP TO n ROWS. SAP is decoupled from the local file system."}], "edges": [{"source": "readme", "target": "readme_sap_abap_mcp_server", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L11", "weight": 1.0}, {"source": "readme", "target": "agents", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L40", "weight": 1.0}, {"source": "readme", "target": "docs_tool_router", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L41", "weight": 1.0}, {"source": "readme", "target": "docs_tool_reference", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L42", "weight": 1.0}, {"source": "readme", "target": "docs_mcp_tools", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L43", "weight": 1.0}, {"source": "readme", "target": "docs_abap_skills", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L44", "weight": 1.0}, {"source": "readme", "target": "docs_development_skills", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L45", "weight": 1.0}, {"source": "readme", "target": "docs_json_rpc", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L46", "weight": 1.0}, {"source": "readme", "target": "docs_authentication", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L47", "weight": 1.0}, {"source": "readme", "target": "github_workflows_ci", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L3", "weight": 1.0}, {"source": "readme", "target": "scripts_live_jsonrpc_check", "relation": "references", "confidence": "EXTRACT