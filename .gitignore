.env
coverage
dist
node_modules
package-lock.json
*.code-workspace

# Client certificates and private keys — never commit key material.
*.p12
*.pfx
*.pem
*.key
*.pse
*.csr

# Kerberos keytabs and ticket caches. A keytab is a password in another form.
*.keytab
krb5cc*

# graphify: share the graph and its extraction cache, not this machine's state.
graphify-out/cost.json
graphify-out/.graphify_python
graphify-out/cache/stat-index.json
graphify-out/cache/hook_sessions/
graphify-out/cache/last_query_stamp
graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/
graphify-out/.graphify_labels.pending.json
graphify-out/.pending_*
graphify-out/.needs_update
graphify-out/**/*.tmp
graphify-out/.graphify_analysis.json
graphify-out/manifest.json
# graphify rebuilds its report and HTML view from graph.json.
graphify-out/GRAPH_REPORT.md
graphify-out/graph.html
