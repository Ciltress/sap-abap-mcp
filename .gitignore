.env
coverage
dist
node_modules
package-lock.json
*.code-workspace

# Client certificates and private keys — never commit key material.
*.p12
*.pfx
*.pem
*.key
*.pse
*.csr

# Kerberos keytabs and ticket caches. A keytab is a password in another form.
*.keytab
krb5cc*

# graphify: only the semantic cache is shared. It holds the LLM extraction of
# the docs, the one part that costs money to rebuild, one small file per doc.
# The graph, its report and HTML view, the AST cache and graphify's state are
# all rebuilt locally: after a clone, run /graphify once (every unchanged doc
# hits this cache, so nothing is extracted), then `graphify update .` as usual.
# An allowlist, so whatever a newer graphify writes stays local too.
graphify-out/*
!graphify-out/cache/
graphify-out/cache/*
!graphify-out/cache/semantic/
graphify-out/**/*.tmp
